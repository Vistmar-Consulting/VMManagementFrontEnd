rules_version = '2';

// VMManagement V1 ruleset.
// See docs/superpowers/specs/2026-05-12-vmmanagement-spinout-design.md §5.
//
// V1 deviation from spec (documented in dev/sessions/.../context.md):
//   - users/{uid} read is allowed for SELF even when the profile doc does
//     not yet exist. Spark plan = no Cloud Functions, so the onCreate
//     trigger that the spec assumes can't run yet; first-sign-in
//     bootstrap happens client-side in AuthContext. The client needs to
//     probe its own doc with getDoc() before deciding to create it.
//   - users/{uid} create constrains role to 'member' and active to true,
//     so clients cannot self-promote. Admin elevation is admin-SDK only
//     (Firebase console for V1) until Members admin page lands.
//   - users/{uid} self-update also blocks changes to `active` (only an
//     admin can deactivate). Spec only blocked `role`; tightening here.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email.matches('.*@vistamarconsulting[.]com$')
          && request.auth.token.email_verified == true;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().active == true;
    }

    function isAdmin() {
      return isActiveUser() && userDoc().role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isActiveUser());

      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'member'
                    && request.resource.data.active == true;

      allow update: if (
                       isActiveUser()
                       && request.auth.uid == uid
                       && !('role' in request.resource.data.diff(resource.data).affectedKeys())
                       && !('active' in request.resource.data.diff(resource.data).affectedKeys())
                     )
                     || isAdmin();

      allow delete: if isAdmin();
    }

    match /organizations/{orgId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Top-level shared categories. Items reference by categoryId string.
    // Column-header filter popovers reduce to those used by visible items;
    // row cell dropdown shows the full list.
    match /categories/{categoryId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Top-level shared tags. Items reference by tagIds string array.
    match /tags/{tagId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /items/{itemId} {
      allow read, write: if isActiveUser();

      match /comments/{commentId} {
        allow read: if isActiveUser();
        allow create: if isActiveUser()
                      && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isActiveUser()
                              && resource.data.authorId == request.auth.uid;
      }

      // File links (URLs only in V1 — actual file uploads land when
      // Blaze enables Firebase Storage). Same author-only edit/delete
      // policy as comments.
      match /files/{fileId} {
        allow read: if isActiveUser();
        allow create: if isActiveUser()
                      && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isActiveUser()
                              && resource.data.authorId == request.auth.uid;
      }
    }

    // Collection group rule for /{any}/comments/{commentId} — required
    // for collectionGroup("comments") queries (used to render the per-row
    // comment count badge without N subscriptions).
    match /{path=**}/comments/{commentId} {
      allow read: if isActiveUser();
    }

    // Same for files — collection group lets the row file-count badge
    // render without subscribing per-item.
    match /{path=**}/files/{fileId} {
      allow read: if isActiveUser();
    }

    match /_meta/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // V2.1.1 — Meeting scheduler / agendas.
    //
    // Data model (matches Console's pm.Calendar_Series ↔ pm.Meeting_Agendas
    // FK shape; see docs/MEETING_AGENDAS_PAGE_REFERENCE.md §9):
    //
    //   calendar_series/{seriesId}     — one doc per meeting series (recurring
    //                                    OR ad-hoc). Holds Graph/Google IDs +
    //                                    recurrence + default attendees.
    //   agendas/{agendaId}             — one doc per agenda. References its
    //                                    calendar_series via calendarSeriesId.
    //                                    Recurring series share one agenda
    //                                    (the running agenda, updated each
    //                                    instance). Ad-hoc has 1:1.
    //
    // Direct-FE-writable fields: title, notes, status, topics, organizationId,
    // free-text display fields. Anything that mutates Graph/Google or
    // depends on an external roundtrip (event IDs, recurrence, meetingDatetime
    // on reschedule, attendee changes) MUST go through a callable — enforced
    // via denylist on update.
    //
    // Create is open because the FE-side reconciliation worker auto-binds
    // newly-discovered Graph events into Firestore. The worker writes Graph
    // IDs at create time; lockdown applies to subsequent updates.

    // V2.1.1 rules are intentionally permissive (read/create/update for any
    // active VM user). The FE's only meeting-mutation surface is the
    // RescheduleDialog, which routes through /api/meetings/reschedule for
    // the Graph + Google writes and then mirrors the new datetime to
    // Firestore. V2.2 re-adds the Graph-ID denylist when create / cancel /
    // attendee UIs land — those would otherwise let a client diverge
    // Firestore from external state.
    match /calendar_series/{seriesId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();
    }

    match /agendas/{agendaId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isAdmin();

      // Topic cards live under each agenda. Pure Firestore state (no
      // Graph/Google sync), so writes are open to any active VM user.
      match /topics/{topicId} {
        allow read, create, update, delete: if isActiveUser();

        match /comments/{commentId} {
          allow read: if isActiveUser();
          allow create: if isActiveUser()
                        && request.resource.data.authorId == request.auth.uid;
          allow update, delete: if isActiveUser()
                                && resource.data.authorId == request.auth.uid;
        }
      }
    }
  }
}
