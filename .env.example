# Firebase web SDK config — copy into .env (or .env.local) and fill in real values from Firebase console
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: emulator suite when developing locally
VITE_FIREBASE_USE_EMULATORS=false

# Fireflies GraphQL API key (app.fireflies.ai -> Integrations -> API). Public-by-design.
VITE_FIREFLIES_KEY=

# ── Vistamar Studio integration (content pipeline → agendas) ──────────────────
# Base URL of the Studio deployment the api/content/* proxy calls. Leave blank
# for local dev (defaults to http://localhost:3007, the Studio Next.js dev
# server); set to the deployed Studio URL in Vercel.
STUDIO_API_URL=
# Shared server-to-server bearer secret. MUST exactly match Studio's
# INTEGRATION_API_SECRET. Server-side only — never expose to the browser.
INTEGRATION_API_SECRET=
